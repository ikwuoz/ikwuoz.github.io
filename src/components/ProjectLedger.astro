---
import type { ProjectEntry } from '../data/portfolio';
import ActionLink from './ActionLink.astro';

interface Props {
	projects: ProjectEntry[];
}

const { projects } = Astro.props;
---

<div class="hidden lg:grid lg:grid-cols-12 gap-x-6 pb-3 border-b border-border-hairline font-mono text-[12px] leading-[1.4] uppercase tracking-[0.08em] text-text-secondary">
	<div class="lg:col-span-1">IDX</div>
	<div class="lg:col-span-6">SYSTEM &amp; ARCHITECTURE</div>
	<div class="lg:col-span-3">PROTOCOL / STACK</div>
	<div class="lg:col-span-2 text-right">LINKS</div>
</div>

<div class="divide-y divide-border-hairline border-b border-border-hairline lg:border-t-0 border-t">
	{
		projects.map((project) => {
			const panelId = `notes-${project.index}`;
			return (
				<article class="group py-6 lg:py-7 px-3 -mx-3 hover:bg-bg-secondary transition-colors duration-150 ease-out">
					<div class="grid grid-cols-1 lg:grid-cols-12 gap-y-4 lg:gap-x-6 items-start">
						<div class="lg:col-span-1 font-mono text-[12px] leading-[1.4] tracking-[0.08em] text-text-secondary group-hover:text-accent-signal transition-colors duration-150 ease-out pt-1">
							{project.index}
						</div>

						<div class="lg:col-span-6">
							<div class="flex flex-wrap items-baseline gap-x-3 gap-y-2">
								<h3 class="text-[22px] font-medium tracking-[-0.02em] leading-[1.25] text-text-primary">
									{project.name}
								</h3>
								{project.highlightAccent ? (
									<span class="font-mono text-[12px] leading-[1.4] uppercase tracking-[0.08em] px-2 py-0.5 border border-accent-signal text-accent-signal">
										{project.highlightTag}
									</span>
								) : (
									<span class="font-mono text-[12px] leading-[1.4] uppercase tracking-[0.08em] text-text-secondary">
										// {project.highlightTag}
									</span>
								)}
							</div>

							<p class="mt-2.5 text-[15px] md:text-[16px] leading-[1.6] text-text-secondary max-w-[62ch]">
								{project.summary}
							</p>

							<div class="mt-3.5">
								<button
									type="button"
									data-notes-toggle
									aria-expanded="false"
									aria-controls={panelId}
									class="inline-flex items-center gap-2 font-mono text-[12px] leading-[1.4] uppercase tracking-[0.08em] text-text-secondary hover:text-accent-signal cursor-pointer transition-colors duration-150 ease-out"
								>
									<span class="notes-toggle-icon" aria-hidden="true">+</span>
									<span>ARCHITECTURE &amp; FOCUS</span>
								</button>

								<div id={panelId} class="notes-drawer" data-open="false">
									<div>
										<p class="mt-2.5 pl-3 border-l border-border-hairline text-[14px] leading-[1.6] text-text-secondary max-w-[58ch]">
											{project.architectureFocus}
										</p>
									</div>
								</div>
							</div>
						</div>

						<div class="lg:col-span-3 flex flex-wrap gap-1.5 pt-0.5">
							{project.stack.map((tech) => (
								<span class="font-mono text-[12px] leading-[1.4] tracking-[0.02em] text-text-secondary bg-bg-secondary group-hover:bg-bg-primary px-2 py-0.5 transition-colors duration-150 ease-out">
									{tech}
								</span>
							))}
						</div>

						<div class="lg:col-span-2 flex lg:flex-col lg:items-end gap-4 lg:gap-2 pt-0.5">
							{project.links.map((link) => (
								<ActionLink
									label={link.label}
									href={link.href}
									external={link.external}
									variant="ledger"
								/>
							))}
						</div>
					</div>
				</article>
			);
		})
	}
</div>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-notes-toggle]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const panelId = btn.getAttribute('aria-controls');
			const panel = panelId ? document.getElementById(panelId) : null;
			if (!panel) return;

			const nextExpanded = btn.getAttribute('aria-expanded') !== 'true';
			btn.setAttribute('aria-expanded', String(nextExpanded));
			panel.setAttribute('data-open', String(nextExpanded));
		});
	});
</script>
