---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderNav from '../components/HeaderNav.astro';
import SectionGrid from '../components/SectionGrid.astro';
import ActionLink from '../components/ActionLink.astro';
import ProjectLedger from '../components/ProjectLedger.astro';
import ExperienceList from '../components/ExperienceList.astro';
import BlogLedger from '../components/BlogLedger.astro';
import FooterColophon from '../components/FooterColophon.astro';
import BackToTop from '../components/BackToTop.astro';
import {
	SITE_META,
	PRIMARY_LINKS,
	SELECTED_WORKS,
	EXPERIENCE_ENTRIES,
} from '../data/portfolio';
import { getPublishedPosts } from '../lib/blog';

const latestPosts = (await getPublishedPosts()).slice(0, 5);
---

<BaseLayout>
	<HeaderNav />

	<main id="main-content">
		<!-- 00 / HEADER & HERO -->
		<SectionGrid id="overview" label="00 / OVERVIEW" headingTag="p">
			<div slot="rail" class="mt-6">
				<div class="w-28 h-28 md:w-36 md:h-36 aspect-square shrink-0 rounded-full border border-border-hairline bg-bg-secondary overflow-hidden">
					<img
						src="/avatar.jpg"
						alt={SITE_META.moniker}
						width="400"
						height="400"
						loading="eager"
						decoding="async"
						class="w-full h-full rounded-full object-cover object-center grayscale contrast-[1.04]"
					/>
				</div>
				<p class="mt-5 font-mono text-[13px] leading-[1.4] text-text-primary tracking-[0.02em]">
					{SITE_META.moniker}
				</p>
				<p class="mt-1 font-mono text-[12px] leading-[1.4] uppercase tracking-[0.08em] text-text-secondary">
					TZ // {SITE_META.timezone}
				</p>
			</div>

			<p class="font-mono text-[12px] leading-[1.4] uppercase tracking-[0.08em] text-text-secondary mb-6">
				{SITE_META.roleTag}
			</p>

			<h1 class="text-[clamp(2.25rem,4.8vw,4.25rem)] font-semibold leading-[1.06] tracking-[-0.03em] text-left text-text-primary">
				{SITE_META.headline}
			</h1>

			<p class="mt-4 md:mt-5 text-[clamp(1.25rem,2.25vw,1.75rem)] font-medium leading-[1.35] tracking-[-0.02em] text-left text-text-secondary max-w-[46ch]">
				{
					SITE_META.subheaderSegments.map((segment) =>
						segment.highlight ? (
							<span class="hero-sub-highlight">{segment.text}</span>
						) : (
							segment.text
						)
					)
				}
			</p>

			<p class="mt-6 text-[15px] md:text-[16px] leading-[1.6] text-text-secondary max-w-[62ch]">
				{SITE_META.subcopy}
			</p>

			<div class="mt-10 pt-7 border-t border-border-hairline flex flex-wrap items-center gap-x-8 gap-y-3">
				{
					PRIMARY_LINKS.map((link) => (
						<ActionLink
							label={link.label}
							href={link.href}
							external={link.external}
							variant="primary"
						/>
					))
				}
			</div>
		</SectionGrid>

		<!-- 01 / SELECTED WORK (PROJECT LEDGER) -->
		<SectionGrid
			id="work"
			label="01 / SELECTED WORK"
		>
			<ProjectLedger projects={SELECTED_WORKS} />
		</SectionGrid>

		<!-- 02 / EXPERIENCE & ECOSYSTEM -->
		<SectionGrid id="experience" label="02 / EXPERIENCE & ECOSYSTEM">
			<ExperienceList entries={EXPERIENCE_ENTRIES} />
		</SectionGrid>

		<!-- 03 / BLOG -->
		<SectionGrid
			id="blog"
			label="03 / BLOG"
		>
			{
				latestPosts.length > 0 ? (
					<>
						<BlogLedger posts={latestPosts} showDescription={false} showTags={false} />
						<div class="mt-8">
							<ActionLink label="VIEW ALL POSTS" href="/blog" variant="primary" />
						</div>
					</>
				) : (
					<p class="font-mono text-[12px] uppercase tracking-[0.08em] text-text-secondary">
						NO PUBLISHED DISPATCHES YET.
					</p>
				)
			}
		</SectionGrid>
	</main>

	<!-- 04 / GET IN TOUCH -->
	<FooterColophon />

	<BackToTop />
</BaseLayout>
